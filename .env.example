# TID Wayfarer core API — copy to .env and fill in real values.

# Postgres connection. DB name stays `tidasone` (existing data/migrations).
DATABASE_URL=postgres://postgres:changeme@localhost:5432/tidasone

# JWT signing secret for user auth (generate: openssl rand -base64 32)
JWT_SECRET=changeme

# Outpost identity (also injected by Helm chart / operator)
OUTPOST_NAME=TIDasONE-Core
OUTPOST_ROLE=core
BODY_ID=399
OUTPOST_REGION=
CORE_API_URL=

# This node's own API endpoint, as reachable by peers
API_ENDPOINT=http://127.0.0.1:3000/api

# Shared secret for node-to-node sync/command routes (generate: openssl rand -hex 32).
# Being fabric-wide, this authenticates any holder as any node — prefer signed
# mode below and keep this only for bootstrapping new outposts.
NODE_SHARED_SECRET=changeme

# How peer nodes authenticate to this one:
#   both   - accept a per-node Ed25519 signature OR NODE_SHARED_SECRET (default;
#            use while rolling an existing fabric onto signed auth)
#   signed - signatures only. NODE_SHARED_SECRET still admits a brand-new node
#            to /api/nodes/register, which carries its own key proof.
#   legacy - shared token only (rollback escape hatch)
FABRIC_AUTH=both

# Comma-separated browser origins allowed by CORS; "*" (default) allows any
ALLOWED_ORIGINS=*

# Listen port (default 3000)
PORT=3000

# --- Settlement verification (SupplyLink marketplace) ---
# An order reaches 'settled' only once a payment is confirmed on-chain. All
# three of payee wallet, bid price, and TIDAT_MINT must be known, or the
# settlement is recorded 'unverifiable' rather than passing as verified.

# Solana JSON-RPC used to confirm settlement transactions. Unset means
# settlements stay unconfirmed (never silently approved).
SOLANA_RPC_URL=

# The SPL mint that counts as payment. Without it any token would satisfy a
# TIDAT expectation, so an unset mint makes settlements unverifiable.
TIDAT_MINT=

# SETTLEMENT_VERIFY=off disables verification for dev/offline rigs.
# Settlements then complete immediately, stamped 'skipped' — never 'verified'.
SETTLEMENT_VERIFY=

# Logging. RUST_LOG sets verbosity (default: tid_wayfarer=info,tower_http=warn,warn);
# set tid_wayfarer=debug for per-cycle daemon heartbeats.
RUST_LOG=tid_wayfarer=info
# LOG_FORMAT=json emits one JSON object per line for a log pipeline;
# anything else keeps the human-readable format.
LOG_FORMAT=
