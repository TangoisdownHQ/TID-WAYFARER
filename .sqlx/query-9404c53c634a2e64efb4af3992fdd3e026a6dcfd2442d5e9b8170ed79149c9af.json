  "query": "\n        INSERT INTO inventory (\n            id, owner_id, name, description, quantity, location,\n            token_id, token_image_url, category, unit, threshold, created_at\n        )\n        VALUES (\n            $1, $2, $3, $4, $5, $6,\n            $7, $8,\n            COALESCE($9, 'general'),\n            COALESCE($10, 'units'),\n            COALESCE($11, 0),\n            NOW()\n        )\n        RETURNING\n            id, owner_id, name, description, quantity, location,\n            token_id, token_image_url, category, unit, threshold, created_at\n        ",
