  "query": "\n        UPDATE inventory\n        SET name = $2,\n            description = $3,\n            quantity = $4,\n            category = COALESCE($5, category),\n            unit = COALESCE($6, unit),\n            threshold = COALESCE($7, threshold)\n        WHERE id = $1\n        RETURNING id, owner_id, name, description, quantity, location,\n                  token_id, token_image_url, category, unit, threshold, created_at\n        ",
