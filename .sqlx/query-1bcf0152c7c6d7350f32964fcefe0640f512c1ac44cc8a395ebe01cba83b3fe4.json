  "db_name": "PostgreSQL",
  "query": "\n        SELECT \n            id::text AS \"id?\",\n            chain,\n            threat,\n            address,\n            tx_hash,\n            severity,\n            context as \"context!\",\n            details as \"details?\",\n            reported_by::text AS \"reported_by?\",\n            created_at as \"created_at!\"\n        FROM blockchain_alerts\n        WHERE ($1::text IS NULL OR chain = $1)\n        ORDER BY created_at DESC\n        LIMIT 200\n        ",
