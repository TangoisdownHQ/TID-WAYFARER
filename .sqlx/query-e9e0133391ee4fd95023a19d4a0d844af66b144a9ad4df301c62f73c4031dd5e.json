{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT \n            r.node_id,\n            r.name,\n            r.api_endpoint,\n            m.lat,\n            m.lon,\n            m.updated_at\n        FROM node_registry r\n        INNER JOIN node_map m ON m.node_id = r.node_id\n        ORDER BY m.updated_at DESC\n        ",
