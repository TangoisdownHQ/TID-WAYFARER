{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT id::text AS \"id!\", body_id, name, feature_type,\n               lat, lon, alt, source, meta\n        FROM surface_features\n        WHERE body_id = $1\n          AND ($2::text IS NULL OR feature_type = $2)\n        ORDER BY feature_type NULLS LAST, name\n        ",
